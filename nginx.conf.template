worker_processes ${WORKER_PROCESSES};

events {
  worker_connections ${WORKER_CONNECTIONS};
}

http {
  include mime.types;

  # Timeout settings
  send_timeout ${SEND_TIMEOUT};
  client_body_timeout ${CLIENT_BODY_TIMEOUT};
  client_header_timeout ${CLIENT_HEADER_TIMEOUT};
  keepalive_timeout ${KEEPALIVE_TIMEOUT};

  # $request_port is empty when the request has no explicit port in the
  # request-line authority or Host header (e.g. plain HTTP requests to the
  # default port 80), so allow that case and explicit port 80 alongside the
  # HTTPS CONNECT ports below.
  map $request_port $allow_port {
      ""             1;
      80             1;
      443            1;
      563            1;
  }

  # map $host $allow_host {
  #     hostnames;

  #     example.org    1;
  #     *.example.org  1;
  # }

  server {
    listen ${PROXY_PORT};

    access_log /dev/stdout;
    error_log  /dev/stderr;

    resolver ${RESOLVER} ipv6=${RESOLVER_IPV6} valid=${RESOLVER_TIMEOUT};

    if ($allow_port != 1) {
        return 502;
    }

    # if ($allow_host != 1) {
    #     return 502;
    # }

    # Plain HTTP (port 80) forward proxying
    location / {
      proxy_pass http://$host$request_uri;
      proxy_set_header Host $host;
      proxy_http_version ${PROXY_HTTP_VERSION};
      proxy_connect_timeout ${PROXY_CONNECT_TIMEOUT};
      proxy_send_timeout ${PROXY_SEND_TIMEOUT};
      proxy_read_timeout ${PROXY_READ_TIMEOUT};
    }

    # HTTPS forward proxying (CONNECT tunnel)
    tunnel_pass;
  }
}
